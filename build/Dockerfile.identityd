# identityd: stateless service whose SQLite database is baked in at build time.
#
# Baking the database is what lets an embedded-DB service scale horizontally:
# every task ships a byte-identical file, so Login and VerifyToken answer the
# same on all of them. Register writes to one task only - see SPEC.md 6.4.
#
# syntax=docker/dockerfile:1
FROM golang:1.27-alpine AS build
WORKDIR /src

# Dependencies first so a code change does not re-download the module cache.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# TARGETARCH is supplied by buildx, so one Dockerfile builds amd64 and arm64.
# Hardcoding amd64 (as the repo this replaces did) means QEMU emulation on an
# M-series laptop and misses Graviton's price advantage.
ARG TARGETARCH
ARG VERSION=dev
# CGO off: the SQLite driver is pure Go (modernc), which is the whole reason a
# static distroless image is possible at all.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-arm64} \
    go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/identityd ./cmd/identityd
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-arm64} \
    go build -trimpath -ldflags="-s -w" -o /out/healthcheck ./cmd/healthcheck

# ---- seed stage: build the database that ships inside the image ----
# Runs natively (no GOARCH override) so it can execute here in the builder.
FROM golang:1.27-alpine AS seed
WORKDIR /src
COPY --from=build /go/pkg/mod /go/pkg/mod
COPY . .
RUN mkdir -p /data && CGO_ENABLED=0 go run ./cmd/seed -db "file:/data/identity.db"
# 65532 is distroless' nonroot uid:gid. The DIRECTORY must be writable too, not
# just the file: SQLite creates -wal and -shm siblings next to the database.
RUN chown -R 65532:65532 /data && chmod 0755 /data && chmod 0644 /data/identity.db

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/identityd /identityd
COPY --from=build /out/healthcheck /healthcheck
COPY --from=seed --chown=65532:65532 /data /data
USER nonroot:nonroot
ENV DB_DRIVER=sqlite \
    DB_URL=file:/data/identity.db \
    GRPC_ADDR=:50051 \
    METRICS_ADDR=:9091
EXPOSE 50051 9091
ENTRYPOINT ["/identityd"]
