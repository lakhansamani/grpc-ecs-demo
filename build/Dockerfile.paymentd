# paymentd: holds writable state, so it runs as ONE task.
#
# Its database starts empty and dies with the task. That is deliberate and is
# the demo's closing lesson - kill the task and the authorizations are gone.
#
# syntax=docker/dockerfile:1
FROM golang:1.27-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETARCH
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-arm64} \
    go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/paymentd ./cmd/paymentd
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-arm64} \
    go build -trimpath -ldflags="-s -w" -o /out/healthcheck ./cmd/healthcheck

# An empty, writable /data. distroless has no shell, so the directory cannot be
# created in the final stage - it is built here and copied with ownership.
RUN mkdir -p /empty-data && chown 65532:65532 /empty-data && chmod 0755 /empty-data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/paymentd /paymentd
COPY --from=build /out/healthcheck /healthcheck
COPY --from=build --chown=65532:65532 /empty-data /data
USER nonroot:nonroot
ENV DB_DRIVER=sqlite \
    DB_URL=file:/data/payment.db \
    GRPC_ADDR=:50052 \
    METRICS_ADDR=:9092 \
    LLM_PROVIDER=template
EXPOSE 50052 9092
ENTRYPOINT ["/paymentd"]
