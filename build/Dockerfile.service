# For services that start with no data: orderd (empty writable database) and
# gatewayd (no database at all).
#
# syntax=docker/dockerfile:1
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG SERVICE
ARG TARGETARCH
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-arm64} \
    go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/app ./cmd/${SERVICE}
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-arm64} \
    go build -trimpath -ldflags="-s -w" -o /out/healthcheck ./cmd/healthcheck
# distroless has no shell, so a writable /data cannot be created in the final
# stage. Build it here and copy it with ownership.
RUN mkdir -p /empty-data && chown 65532:65532 /empty-data && chmod 0755 /empty-data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/app /app
COPY --from=build /out/healthcheck /healthcheck
COPY --from=build --chown=65532:65532 /empty-data /data
USER nonroot:nonroot
ENV DB_DRIVER=sqlite
ENTRYPOINT ["/app"]
