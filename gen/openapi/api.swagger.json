{
  "swagger": "2.0",
  "info": {
    "title": "order/v1/order.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "OrderService",
      "description": "OrderService writes orders.\n\nIt is the only stateful service here, so it runs as ONE task - and that is\nthe point: you scale reads, not writes. Every CreateOrder makes TWO outbound\ngRPC calls: UserService to find out who is asking, and ProductService to find\nout what things actually cost."
    },
    {
      "name": "ProductService",
      "description": "ProductService is the catalogue: browse, search, and the authoritative\nsource of price and stock.\n\nRead-heavy by a wide margin - most browsing never becomes an order - which\nis why this is the service that scales out during a sale."
    },
    {
      "name": "UserService",
      "description": "UserService owns accounts and tokens.\n\nStateless: its database is baked into the image, so every task answers reads\nidentically and the service scales horizontally. It is called by the REST\ngateway AND by OrderService, which makes it the busiest hop in the system."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/orders": {
      "get": {
        "operationId": "OrderService_ListOrders",
