# Copy to terraform.tfvars and fill in. That file is gitignored, because it
# holds your account's image URIs and your own public IP address.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# `make images-push` prints the four image lines ready to paste.

aws_region = "us-east-1"

user_image    = "<ACCOUNT>.dkr.ecr.us-east-1.amazonaws.com/userd:0.1.0"
product_image = "<ACCOUNT>.dkr.ecr.us-east-1.amazonaws.com/productsd:0.1.0"
order_image   = "<ACCOUNT>.dkr.ecr.us-east-1.amazonaws.com/orderd:0.1.0"
gateway_image = "<ACCOUNT>.dkr.ecr.us-east-1.amazonaws.com/gatewayd:0.1.0"

# There is no load balancer, so this security-group rule is the ONLY way in.
# Empty means nothing is reachable. IPv4 only - an IPv6 address in a cidr_ipv4
# field fails the apply partway through.
#   curl ifconfig.me
operator_ingress_cidrs = ["YOUR.IPV4.HERE/32"]

# Optional: one db.t4g.micro, a separate database per service.
# ~$14/month if left running, ~6 cents for a three-hour demo.
# use_rds = true
